PORT=3000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_PROCESSING_TIMEOUT_MS=25000
# Comma-separated browser origins; include your frontend's exact scheme, host, and port.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Reserved for deployments that add a Supabase integration. This app does not
# upload or persist screenshots in Supabase or any other storage service.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
